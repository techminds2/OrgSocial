generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublicAccessMode {
  open
  request
}

enum CalendarNoteType {
  PERSONAL
  MEETING
  ADMIN_REMINDER
}

model User {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  email        String? @unique
  role         String
  isStaff      Boolean @default(false)
  profileImage String?

  posts         Post[]
  comments      Comment[]
  reactions     Reaction[]
  channelMember ChannelMember[]

  createdChannels Channel[]      @relation("ChannelCreator")
  notifications   Notification[]
  joinRequests    JoinRequest[]
  savedPosts      SavedPost[]
  todos           Todo[]
  postSeen        PostSeen[]
  pinnedChannelId Int?
  pinnedChannel   Channel?       @relation(fields: [pinnedChannelId], references: [id], onDelete: SetNull)

  notificationsActed Notification[] @relation("NotificationActor")

  dailyReports           DailyReport[]
  regionalReports        RegionalDailyReport[]
  regionalMonthlyTargets RegionalMonthlyTarget[]
  calendarNotesForUser   CalendarNote[]          @relation("CalendarNotesForUser")
  calendarNotesCreated   CalendarNote[]          @relation("CalendarNotesCreated")
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  channelId Int?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  files     File[]
  comments  Comment[]
  reactions Reaction[]
  savedBy   SavedPost[]
  seenBy    PostSeen[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  postId Int
  post   Post @relation(fields: [postId], references: [id])

  authorId Int
  author   User @relation(fields: [authorId], references: [id])
}

model Reaction {
  id   Int    @id @default(autoincrement())
  type String

  postId Int
  post   Post @relation(fields: [postId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@unique([postId, userId, type])
}

model File {
  id     Int     @id @default(autoincrement())
  url    String
  type   String?
  postId Int
  post   Post    @relation(fields: [postId], references: [id])
}

model Channel {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  createdById Int
  createdBy   User @relation("ChannelCreator", fields: [createdById], references: [id])

  bannerKey        String?
  visibility       String           @default("private")
  publicAccessMode PublicAccessMode @default(request)

  postSeen      PostSeen[]
  members       ChannelMember[]
  posts         Post[]
  joinRequests  JoinRequest[]
  pinnedByUsers User[]
  notifications Notification[]
}

model ChannelMember {
  id        Int    @id @default(autoincrement())
  channelId Int
  userId    Int
  role      String @default("viewer")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
}

model JoinRequest {
  id            Int            @id @default(autoincrement())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  channelId     Int
  userId        Int
  status        String         @default("pending")
  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([channelId, userId])
  @@index([channelId, status])
  @@index([userId, status])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  actorId       Int?
  channelId     Int?
  joinRequestId Int?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor       User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  channel     Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  joinRequest JoinRequest? @relation(fields: [joinRequestId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([actorId])
  @@index([channelId])
  @@index([joinRequestId])
}

model SavedPost {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

enum Priority {
  Low
  Medium
  High
}

model Todo {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  priority    Priority
  completed   Boolean   @default(false)
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, completed, completedAt])
}

model PostSeen {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  channelId Int
  seenAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, channelId])
  @@index([channelId, seenAt])
}

model DailyReport {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  reportYmd  String
  branchName String

  newConnectionRequest    Int     @default(0)
  pendingConnection       Int     @default(0)
  completedConnection     Int     @default(0)
  reasonPendingConnection String?

  internetTkt      Int     @default(0)
  pendingTkt       Int     @default(0)
  completedTkt     Int     @default(0)
  reasonPendingTkt String?

  expireCustomerDay   Int     @default(0)
  renewDay            Int     @default(0)
  activeCustomer      Int     @default(0)
  totalExpireCustomer Int     @default(0)
  outgoingCalls       Int     @default(0)
  trunkIssueRemarks   String?

  @@unique([authorId, reportYmd])
  @@index([authorId, reportYmd])
  @@index([reportYmd])
}

model RegionalMonthlyTarget {
  id     Int    @id @default(autoincrement())
  userId Int
  month  String
  year   Int

  collectionTarget    Int @default(0)
  newConnectionTarget Int @default(0)
  renewalTarget       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId, month])
  @@index([month])
}

model RegionalDailyReport {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  reportYmd  String
  regionName String

  branchesVisitedToday String? @db.Text
  keyObservations      String? @db.Text

  totalCollection   Int @default(0)
  activeCustomers   Int @default(0)
  expiredCustomers  Int @default(0)
  totalCustomerBase Int @default(0)

  totalTickets         Int     @default(0)
  pendingTickets       Int     @default(0)
  ticketsClosedToday   Int     @default(0)
  reasonPendingTickets String? @db.Text

  totalNewConnections     Int     @default(0)
  newConnectionsToday     Int     @default(0)
  connectionPendingToday  Int     @default(0)
  renewalsToday           Int     @default(0)
  renewalPending          Int     @default(0)
  reasonPendingConnection String? @db.Text

  collectionTarget            Int   @default(0)
  collectionAchievement       Int   @default(0)
  newConnectionTarget         Int   @default(0)
  newConnectionAchievementPct Float @default(0)
  renewalTarget               Int   @default(0)
  renewalAchievementPct       Float @default(0)

  issueDetails String? @db.Text

  immediateActionsTaken String? @db.Text
  nextDayPlan           String? @db.Text
  supportRequiredFromHO String? @db.Text

  @@unique([authorId, reportYmd])
  @@index([authorId, reportYmd])
  @@index([reportYmd])
}

model CalendarNote {
  id          Int              @id @default(autoincrement())
  userId      Int
  createdById Int
  noteDate    String
  title       String
  description String?
  type        CalendarNoteType @default(PERSONAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User @relation("CalendarNotesForUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("CalendarNotesCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([userId, noteDate])
  @@index([createdById])
  @@index([userId, type, noteDate])
}
