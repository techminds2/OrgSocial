generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String
  email     String?   @unique
  role      String
  isStaff   Boolean   @default(false)
  posts     Post[]
  comments  Comment[]
  reactions Reaction[]
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  reactions Reaction[]
  files     File[]
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  post      Post      @relation(fields: [postId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])
}

model Reaction {
  id        Int       @id @default(autoincrement())
  type      String    
  post      Post      @relation(fields: [postId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model File {
  id        Int       @id @default(autoincrement())
  url       String  
  post      Post      @relation(fields: [postId], references: [id])
}
