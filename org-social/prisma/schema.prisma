
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//This is users table
model User {
  id           Int      @id
  username     String
  email        String?
  role         String
  is_staff     Boolean
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
}