generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id           Int       @id @default(autoincrement())
  username     String
  email        String?   @unique
  role         String
  isStaff      Boolean   @default(false)
  profileImage String?    

  posts     Post[]
  comments  Comment[]
  reactions Reaction[]
}


model Post {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())

  authorId  Int                    
  author    User      @relation(fields: [authorId], references: [id])

  comments  Comment[]
  reactions Reaction[]
  files     File[]
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())

  postId    Int                    
  post      Post      @relation(fields: [postId], references: [id])

  authorId  Int                    
  author    User      @relation(fields: [authorId], references: [id])
}

model Reaction {
  id        Int       @id @default(autoincrement())
  type      String    

  postId    Int                    
  post      Post      @relation(fields: [postId], references: [id])

  userId    Int                    
  user      User      @relation(fields: [userId], references: [id])
}

model File {
  id        Int      @id @default(autoincrement())
  url       String
  type      String

  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
}
